{ buildKernelWithNix }:

let
  version = "KERNELVERSION";
  modDirVersion = "KERNELRELEASE";
  kernelUtsMachine = "UTS_MACHINE";
  kernelArch = "ARCH";
  crossCompile = "CROSS_COMPILE";
in

import <nixpkgs/nixos> {
  configuration =
    {
      config,
      lib,
      pkgs,
      modulesPath,
      ...
    }:
    let
      prebuiltKernel = pkgs.linuxPackagesFor (
        import ./prebuilt-kernel.nix {
          inherit
            lib
            pkgs
            version
            modDirVersion
            kernelArch
            crossCompile
            ;
        }
      );
      kernelBuiltWithNix = pkgs.linuxPackagesFor (
        pkgs.linuxManualConfig {
          inherit version;
          modDirVersion = version; # in a clean build, `modDirVersion` is the `version`
          src = ../../linux.tar.gz;
          # The user must build a `$(srctree)/.config` file for any
          # `make` targets to realize. Use that config file.
          configfile = pkgs.runCommand "kernel-config" { } ''
            cp ${../../.config} $out
          '';
          allowImportFromDerivation = true;
        }
      );
    in
    {
      imports = [
        "${modulesPath}/virtualisation/qemu-vm.nix"
      ];

      boot = {
        kernelPackages = if buildKernelWithNix then kernelBuiltWithNix else prebuiltKernel;
        loader = {
          systemd-boot.enable = true;
          timeout = 1;
        };
        kernelParams = [ "console=ttyS0,115200" ];
      };

      virtualisation = {
        memorySize = 2048;
        cores = 2;
        graphics = false;
        # `virtualisation.writableStore` mounts `/nix/store` in the VM
        # as a writeable path. But that needs overlayfs, which isn't
        # enabled even with the `defconfig` on x86_64. Unless overlayfs
        # is available to the VM, keep the assigned value to `false`.
        writableStore = false;
      };

      # The `system.requiredKernelConfig` configuration option ensures
      # that the Kernel config file has certain Kconfig options enabled.
      # In our case, the Kernel config file is generated by the user's
      # choices, not automatically by the NixOS Kernel configuration
      # build script. This causes collision. Best to disable it by
      # assigning an empty list to ensure no Kconfig options' values are
      # checked.
      system.requiredKernelConfig = lib.mkForce [ ];

      # Nixpkgs has a good list of modules but just like
      # `system.requiredKernelConfig`, some expected modules are either
      # disabled or are built into the kernel itself. This causes an
      # error in building the "linux-${version}-modules" derivation
      # for the NixOS system. Therefore, _force_ a minimal set of
      # modules enough for a VM.
      boot.initrd.kernelModules = {
        virtio_balloon = lib.mkForce false;
        virtio_rng = lib.mkForce false;
        virtio_gpu = lib.mkForce false;
      };
      boot.initrd.availableKernelModules = lib.mkForce (
        [
          "ahci"
          "dm_mod"
          "sd_mod"
          "virtio_blk"
          "virtio_console"
          "virtio_pci"
          "virtio_ring"
        ]
        ++ lib.lists.optionals pkgs.stdenv.isx86_64 [
          "sr_mod"
          "virtio_input"
        ]
      );

      environment.systemPackages = with pkgs; [
        # If you wish to install any packages in the system
        # search for package name at <https://search.nixos.org/packages>
        # and paste it below, before the closing `]`
        vim
      ];

      networking.hostName = "nixos";
      networking.networkmanager.enable = true;

      time.timeZone = "Etc/UTC";
      i18n = {
        defaultLocale = "en_US.UTF-8";
        extraLocaleSettings = {
          LC_ADDRESS = "en_US.UTF-8";
          LC_IDENTIFICATION = "en_US.UTF-8";
          LC_MEASUREMENT = "en_US.UTF-8";
          LC_MONETARY = "en_US.UTF-8";
          LC_NAME = "en_US.UTF-8";
          LC_NUMERIC = "en_US.UTF-8";
          LC_PAPER = "en_US.UTF-8";
          LC_TELEPHONE = "en_US.UTF-8";
          LC_TIME = "en_US.UTF-8";
        };
      };

      services.getty.autologinUser = "kdvuser";
      users = {
        groups."kdvuser" = { };
        users = {
          "root".password = lib.mkForce ""; # set empty password for `root`
          "kdvuser" = {
            password = lib.mkForce ""; # set empty password for `kdvuser`
            isNormalUser = true; # get `uid` allocated >=1000
            group = "kdvuser";
            extraGroups = [
              "wheel"
              "kvm"
              "systemd-journal"
            ];
          };
        };

        # This enforces any users not created by Nix are invalid and are
        # "erased" (more like they never existed by simply overwriting
        # /etc/shadow, and other files). Setting it to `false` ensures
        # your users+groups not defined here aren't overwritten.
        mutableUsers = false;
      };
      security = {
        sudo = {
          enable = true;
          wheelNeedsPassword = false;
          # no first password prompt banner "with great power comes great responsibility"
          extraConfig = ''
            Defaults lecture = never
          '';
        };
        polkit = {
          enable = true;
          # For `systemctl (reboot|poweroff)` without authentication
          extraConfig = ''
            polkit.addRule(function (action, subject) {
              if (
                subject.isInGroup("kdvuser") &&
                [
                  "org.freedesktop.login1.reboot",
                  "org.freedesktop.login1.reboot-multiple-sessions",
                  "org.freedesktop.login1.power-off",
                  "org.freedesktop.login1.power-off-multiple-sessions",
                ].indexOf(action.id) !== -1
              ) {
                return polkit.Result.YES;
              }
            });
          '';
        };
      };

      # Not necessary for the VM itself, but `filesystems."/"` must
      # be set for a NixOS system to evaluate.
      fileSystems = {
        "/" = {
          device = "/dev/vda1";
          fsType = "ext4";
        };
      };

      # For cross compilation, triggers when necessary otherwise stays
      # out of the way.
      nixpkgs.hostPlatform = "${kernelUtsMachine}-linux";
      nixpkgs.buildPlatform = builtins.currentSystem;
      virtualisation.host.pkgs = pkgs.buildPackages;

      # This value determines the NixOS release from which the default
      # settings for stateful data, like file locations and database versions
      # on your system were taken. It‘s perfectly fine and recommended to leave
      # this value at the release version of the first install of this system.
      # Before changing this value read the documentation for this option
      # (e.g. man configuration.nix or on https://nixos.org/nixos/options.html).
      system.stateVersion = "25.11"; # Did you read the comment?
    };
}
